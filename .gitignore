# Virtual environment
venv/

# Environment variables (contains your API key)
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class

# IDE / Editor folders
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Generated output — ignore everything inside, but keep the folder itself
output/*
!output/.gitkeep

# Published files — ignore everything inside, but keep the folder itself
publish/*
!publish/.gitkeep

categories/*
!categories/dinosaurs.txt

translations/*/*
!translations/dinosaurs/
!translations/dinosaurs/he.json